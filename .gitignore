# --- secrets and credentials: never tracked, anywhere in this repo ---
*.key
*.pem
*.p12
*.pfx
cosign.key
cosign.pub.bak
.env
.env.*
kubeconfig
kubeconfig.*
*.kubeconfig
*credentials*
*.tfvars
!*.tfvars.example

# --- terraform ---
# .terraform.lock.hcl is intentionally NOT ignored in general: root
# configurations (infra/terraform/envs/*) commit it for reproducible
# provider versions, per Terraform's own recommendation. Everything under
# infra/terraform/modules/ is validated standalone in CI (each has its own
# required_providers) but isn't an independent root meant to be applied on
# its own, so no lock file is committed for those — including
# tfstate-backend, whose one real, standalone `terraform init` happens by
# hand on whoever actually bootstraps a backend, not here.
.terraform/
/zero-trust-gitops-platform/infra/terraform/modules/*/.terraform.lock.hcl
/zero-trust-gitops-platform/infra/terraform/policy/tests/**/.terraform.lock.hcl
/zero-trust-gitops-platform/infra/terraform/tests/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- go ---
/zero-trust-gitops-platform/apps/**/bin/
*.test
*.out

# --- kind / local demo state ---
demo/.kube/
demo/kind-kubeconfig*

# --- editors / OS ---
.DS_Store
*.swp
.idea/
.vscode/

# --- tool caches ---
.cache/
node_modules/

# --- generated docs site (mkdocs build output — rebuilt by CI/Pages, not committed) ---
/zero-trust-gitops-platform/site/
